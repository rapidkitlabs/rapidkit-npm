#!/usr/bin/env sh

# Type checking
echo "🔍 Running type check..."
npm run typecheck || exit 1

# Linting
echo "🧹 Running linter..."
npx lint-staged || exit 1

# Format check
echo "💅 Checking code formatting..."
npm run format:check || exit 1

# Contract checks are scoped to staged contract work. Running full-tree sync from
# pre-commit can accidentally stage unrelated working-tree changes (or mutate a
# sibling repository). CI and release quality gates still enforce full parity.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if printf '%s\n' "$STAGED_FILES" | grep -Eq '^(docs/contracts/rapidkit-cli-contracts\.json|scripts/sync-contracts\.mjs)$'; then
	if [ -n "${RAPIDKIT_CORE_SCHEMA_PATH:-}" ] && [ -f "${RAPIDKIT_CORE_SCHEMA_PATH}" ]; then
		echo "🔗 Checking staged Core ↔ NPM contract work..."
		npm run check:contracts || exit 1
	elif [ -f "../core/docs/contracts/rapidkit-cli-contracts.json" ]; then
		echo "🔗 Checking staged Core ↔ NPM contract work (monorepo)..."
		RAPIDKIT_CORE_SCHEMA_PATH="../core/docs/contracts/rapidkit-cli-contracts.json" npm run check:contracts || exit 1
	elif [ -f "../../core/docs/contracts/rapidkit-cli-contracts.json" ]; then
		echo "🔗 Checking staged Core ↔ NPM contract work (monorepo)..."
		RAPIDKIT_CORE_SCHEMA_PATH="../../core/docs/contracts/rapidkit-cli-contracts.json" npm run check:contracts || exit 1
	else
		echo "ℹ️ Skipping Core contract check (Core schema not found)"
	fi
else
	echo "ℹ️ Skipping Core contract check (no related staged changes)"
fi

if printf '%s\n' "$STAGED_FILES" | grep -Eq '^(contracts/|src/contracts/|src/utils/(kit-registry|project-command-capabilities|support-matrix|workspace-command-surface)\.ts$|src/frontend-project\.ts$|scripts/(generate-shared-contracts|run-generate-shared-contracts|sync-shared-contracts)\.(mjs|ts)$)'; then
	echo "📋 Validating staged shared-contract work..."
	npm run validate:contracts || {
		echo "❌ Contract validation failed."
		echo "   Regenerate explicitly with: npm run sync:shared-contracts"
		echo "   Then review and stage only the intended contract changes."
		exit 1
	}
else
	echo "ℹ️ Skipping shared-contract validation (no related staged changes)"
fi

# Tests
echo "🧪 Running tests..."
npm test || exit 1

echo "✅ All checks passed!"
